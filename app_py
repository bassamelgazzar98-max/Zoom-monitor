# ------------------------------------------------------- name normalization
# Arabic display names vary a lot: alef/hamza forms, taa marbuta, yaa/alef
# maqsura, tatweel, diacritics. We normalize before comparing. Transliterated
# variants (Mohamed vs محمد) are NOT guessed; they come out as unknown or
# probable and are flagged for human review. Known variants can be pinned in
# the eligibility CSV "aliases" column.

AR_MARKS = re.compile(r"[ً-ْٰـ]")

def normalize(name):
    if not name:
        return ""
    n = unicodedata.normalize("NFKD", name.strip().lower())
    n = AR_MARKS.sub("", n)
    for a, b in (("أ", "ا"), ("إ", "ا"), ("آ", "ا"), ("ٱ", "ا"),
                 ("ة", "ه"), ("ى", "ي"), ("ؤ", "و"), ("ئ", "ي")):
        n = n.replace(a, b)
    n = re.sub(r"[^0-9a-zء-غف-ي٠-٩]+", " ", n)
    return " ".join(n.split())

def token_sim(a, b):
    ta, tb = set(a.split()), set(b.split())
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)

PROBABLE_THRESHOLD = 0.6

def match_name(name, conn):
    """-> (status, matched_display_name)
    status in: excluded | eligible | ineligible | probable | unknown"""
    key = normalize(name)
    if not key:
        return ("unknown", None)
    row = conn.execute(
        "SELECT name_key FROM aliases WHERE alias_key=?", (key,)).fetchone()
    if row:
        key = row["name_key"]
    ex = conn.execute(
        "SELECT display_name FROM exclusions WHERE name_key=?", (key,)).fetchone()
    if ex:
        return ("excluded", ex["display_name"])
    el = conn.execute(
        "SELECT display_name, eligible FROM eligibility WHERE name_key=?",
        (key,)).fetchone()
    if el:
        return (("eligible" if el["eligible"] else "ineligible"),
                el["display_name"])
    # fuzzy: token overlap against the sheet; ties or weak hits stay unknown
    best, best_score, tie = None, 0.0, False
    for r in conn.execute(
            "SELECT name_key, display_name, eligible FROM eligibility").fetchall():
        s = token_sim(key, r["name_key"])
        if s > best_score:
            best, best_score, tie = r, s, False
        elif s == best_score and best is not None and r["name_key"] != best["name_key"]:
            tie = True
    if best is not None and best_score >= PROBABLE_THRESHOLD and not tie:
        return ("probable", best["display_name"])
    return ("unknown", None)

# ------------------------------------------------------------------ helpers

def parse_iso(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None

def alert(conn, meeting_uuid, pkey, type_, severity, message):
    """Insert once per (meeting, participant, type). Returns True if new."""
    cur = conn.execute(
        "INSERT OR IGNORE INTO alerts"
        " (ts, meeting_uuid, participant_key, type, severity, message)"
        " VALUES (?,?,?,?,?,?)",
        (time.time(), meeting_uuid, pkey, type_, severity, message))
    return cur.rowcount > 0

def presence_seconds(p, now):
    total = p["present_seconds"] or 0.0
    if p["present_since"]:
        total += now - p["present_since"]
    return total

def absence_min(meeting, p, now):
    start = meeting["start_ts"] or now
    end = meeting["end_ts"] or now
    elapsed = max(0.0, end - start)
    return max(0.0, elapsed - presence_seconds(p, now)) / 60.0

# -------------------------------------------------------------- zoom events

def ensure_meeting(conn, obj, ts):
    uuid = obj.get("uuid") or str(obj.get("id") or "unknown")
    conn.execute(
        "INSERT OR IGNORE INTO meetings (uuid, meeting_id, topic, start_ts)"
        " VALUES (?,?,?,?)",
        (uuid, str(obj.get("id") or ""), obj.get("topic") or "",
         parse_iso(obj.get("start_time")) or ts))
    row = conn.execute("SELECT * FROM meetings WHERE uuid=?", (uuid,)).fetchone()
    return row

def find_participant(conn, meeting_uuid, zuid, name_key):
    if zuid:
        row = conn.execute(
            "SELECT * FROM participants WHERE meeting_uuid=? AND zoom_user_id=?",
            (meeting_uuid, zuid)).fetchone()
        if row:
            return row
    return conn.execute(
        "SELECT * FROM participants WHERE meeting_uuid=? AND name_key=?",
        (meeting_uuid, name_key)).fetchone()

def on_waiting_room(conn, meeting, obj, ts):
    p = obj.get("participant") or {}
    name = p.get("user_name") or "(no name)"
    key = normalize(name)
    topic = meeting["topic"] or meeting["meeting_id"]
    status, matched = match_name(name, conn)
    start = meeting["start_ts"] or ts
    elapsed_min = max(0.0, (ts - start)) / 60.0
    too_late = elapsed_min >= ABSENCE_LIMIT_MIN

    if status == "excluded":
        alert(conn, meeting["uuid"], key, "waiting_room_block", "high",
              f"{name}: طلب دخول من صالة الانتظار وهو في قائمة الاستبعاد "
              f"- مينفعش يتقبل / On the manual exclusion list - do NOT admit. "
              f"[{topic}]")
    elif status == "ineligible":
        alert(conn, meeting["uuid"], key, "waiting_room_block", "high",
              f"{name}: طلب دخول وهو في الشيت كمرفوض ({matched}) "
              f"- مينفعش يتقبل / On the sheet as not allowed - do NOT admit. "
              f"[{topic}]")
    elif status == "eligible":
        if too_late:
            alert(conn, meeting["uuid"], key, "waiting_room_block", "high",
                  f"{name}: على قائمة المقبولين لكن وصل بعد مرور "
                  f"{int(elapsed_min)} دقيقة من السيشن (الحد {ABSENCE_LIMIT_MIN}) "
                  f"- مينفعش يتقبل / On the accept list but arrived "
                  f"{int(elapsed_min)} min in (limit {ABSENCE_LIMIT_MIN}) "
                  f"- do NOT admit. [{topic}]")
        else:
            alert(conn, meeting["uuid"], key, "waiting_room_ok", "info",
                  f"{name}: على قائمة المقبولين - ممكن يتقبل "
                  f"/ On the accept list - OK to admit. [{topic}]")
    elif status == "probable":
        alert(conn, meeting["uuid"], key, "needs_review", "medium",
              f"{name}: أقرب اسم في الشيت هو ({matched}) - راجع بنفسك قبل "
              f"القبول / Closest sheet match is ({matched}) - review before "
              f"admitting. [{topic}]")
    else:
        alert(conn, meeting["uuid"], key, "needs_review", "medium",
              f"{name}: طلب دخول واسمه مش موجود في الشيت - راجع بنفسك "
              f"/ Not found on the uploaded sheet - review. [{topic}]")

def on_joined(conn, meeting, obj, ts):
    p = obj.get("participant") or {}
    name = p.get("user_name") or "(no name)"
    zuid = p.get("user_id") or ""
    email = p.get("email") or ""
    key = normalize(name)
    join_ts = parse_iso(p.get("join_time")) or ts
    topic = meeting["topic"] or meeting["meeting_id"]

    # Mid-session deploys: the earliest known start wins.
    if join_ts < (meeting["start_ts"] or join_ts):
        conn.execute("UPDATE meetings SET start_ts=? WHERE uuid=?",
                     (join_ts, meeting["uuid"]))
        meeting = conn.execute("SELECT * FROM meetings WHERE uuid=?",
                               (meeting["uuid"],)).fetchone()
    row = find_participant(conn, meeting["uuid"], zuid, key)
    if row:
        # Possible mid-session rename: keep identity via zoom_user_id.
        if zuid and row["name_key"] != key:
            alert(conn, meeting["uuid"], key, "renamed", "medium",
                  f"{row['name']} غيّر اسمه إلى {name} جوه الاجتماع "
                  f"/ Renamed to {name} mid-meeting. [{topic}]")
            conn.execute(
                "UPDATE participants SET name=?, name_key=? WHERE id=?",
                (name, key, row["id"]))
        if not row["present_since"]:
            conn.execute(
                "UPDATE participants SET present_since=? WHERE id=?",
                (join_ts, row["id"]))
        if email and not row["email"]:
            conn.execute("UPDATE participants SET email=? WHERE id=?",
                         (email, row["id"]))
    else:
        conn.execute(
            "INSERT INTO participants (meeting_uuid, zoom_user_id, name,"
            " name_key, email, first_join_ts, present_since, present_seconds)"
            " VALUES (?,?,?,?,?,?,?,0)",
            (meeting["uuid"], zuid, name, key, email, join_ts, join_ts))
        late_min = (join_ts - (meeting["start_ts"] or join_ts)) / 60.0
        if late_min > LATE_ALERT_MIN:
            alert(conn, meeting["uuid"], key, "late", "medium",
                  f"{name}: دخل السيشن متأخر {int(late_min)} دقيقة "
                  f"/ Joined {int(late_min)} min late. [{topic}]")
        status, matched = match_name(name, conn)
        if status == "probable":
            alert(conn, meeting["uuid"], key, "needs_review", "medium",
                  f"{name}: أقرب اسم في الشيت هو ({matched}) - راجع "
                  f"/ Closest sheet match is ({matched}) - review. [{topic}]")
        elif status == "unknown":
            alert(conn, meeting["uuid"], key, "needs_review", "medium",
                  f"{name}: دخل واسمه مش موجود في الشيت - راجع "
                  f"/ Joined but not found on the sheet - review. [{topic}]")
        elif status == "excluded":
            alert(conn, meeting["uuid"], key, "excluded_inside", "high",
                  f"{name}: دخل الاجتماع وهو في قائمة الاستبعاد "
                  f"/ Joined while on the manual exclusion list. [{topic}]")
        elif status == "ineligible":
            alert(conn, meeting["uuid"], key, "excluded_inside", "high",
                  f"{name}: دخل الاجتماع وهو مرفوض في الشيت ({matched}) "
                  f"/ Joined while marked not allowed on the sheet. [{topic}]")

def on_left(conn, meeting, obj, ts):
    p = obj.get("participant") or {}
    name = p.get("user_name") or "(no name)"
    zuid = p.get("user_id") or ""
    key = normalize(name)
    leave_ts = parse_iso(p.get("leave_time")) or ts
    topic = meeting["topic"] or meeting["meeting_id"]

    row = find_participant(conn, meeting["uuid"], zuid, key)
    if row and row["present_since"]:
        gained = max(0.0, leave_ts - row["present_since"])
        conn.execute(
            "UPDATE participants SET present_since=NULL,"
            " present_seconds=present_seconds+? WHERE id=?",
            (gained, row["id"]))
        row = conn.execute("SELECT * FROM participants WHERE id=?",
                           (row["id"],)).fetchone()
        now = leave_ts
        if absence_min(meeting, row, now) >= ABSENCE_LIMIT_MIN:
            alert(conn, meeting["uuid"], key, "absence_exceeded", "high",
                  f"{name}: خرج وغيابه المتراكم عدّى {ABSENCE_LIMIT_MIN} دقيقة "
                  f"- لو رجع يطلب دخول، مينفعش يتقبل / Left; cumulative absence "
                  f"passed {ABSENCE_LIMIT_MIN} min - do NOT re-admit. [{topic}]")
        else:
            alert(conn, meeting["uuid"], key, "left", "info",
                  f"{name}: خرج من الاجتماع (غياب متراكم "
                  f"{int(absence_min(meeting, row, now))} دقيقة) "
                  f"/ Left the meeting. [{topic}]")

def handle_event(event, payload, event_ts):
    ts = (event_ts or int(time.time() * 1000)) / 1000.0
    obj = (payload or {}).get("object") or {}
    with LOCK, db() as conn:
        meeting = ensure_meeting(conn, obj, ts)
        if event == "meeting.started":
            conn.execute(
                "UPDATE meetings SET start_ts=?, topic=? WHERE uuid=?",
                (parse_iso(obj.get("start_time")) or ts,
                 obj.get("topic") or meeting["topic"], meeting["uuid"]))
        elif event == "meeting.ended":
            conn.execute("UPDATE meetings SET end_ts=? WHERE uuid=?",
                         (parse_iso(obj.get("end_time")) or ts, meeting["uuid"]))
            # close presence for anyone still marked inside
            for r in conn.execute(
                    "SELECT * FROM participants WHERE meeting_uuid=? AND"
                    " present_since IS NOT NULL", (meeting["uuid"],)).fetchall():
                conn.execute(
                    "UPDATE participants SET present_since=NULL,"
                    " present_seconds=present_seconds+? WHERE id=?",
                    (max(0.0, ts - r["present_since"]), r["id"]))
        elif event == "meeting.participant_joined_waiting_room":
            on_waiting_room(conn, meeting, obj, ts)
        elif event == "meeting.participant_joined":
            on_joined(conn, meeting, obj, ts)
        elif event == "meeting.participant_left":
            on_left(conn, meeting, obj, ts)

# ------------------------------------------------------------------- state

def build_state():
    now = time.time()
    with LOCK, db() as conn:
        meetings = []
        for m in conn.execute(
                "SELECT * FROM meetings ORDER BY start_ts DESC LIMIT 20").fetchall():
            plist = []
            for p in conn.execute(
                    "SELECT * FROM participants WHERE meeting_uuid=?"
                    " ORDER BY name", (m["uuid"],)).fetchall():
                ab = absence_min(m, p, now)
                if (not p["present_since"] and not m["end_ts"]
                        and ab >= ABSENCE_LIMIT_MIN):
                    alert(conn, m["uuid"], p["name_key"],
                          "absence_exceeded", "high",
                          f"{p['name']}: الغياب المتراكم عدّى "
                          f"{ABSENCE_LIMIT_MIN} دقيقة - لو رجع يطلب دخول، "
                          f"مينفعش يتقبل / Cumulative absence passed "
                          f"{ABSENCE_LIMIT_MIN} min - do NOT re-admit.")
                status, matched = match_name(p["name"], conn)
                late_min = 0
                if p["first_join_ts"] and m["start_ts"]:
                    late_min = max(0, (p["first_join_ts"] - m["start_ts"]) / 60.0)
                plist.append({
                    "name": p["name"],
                    "email": p["email"] or "",
                    "present": bool(p["present_since"]),
                    "present_min": round(presence_seconds(p, now) / 60.0, 1),
                    "absence_min": round(ab, 1),
                    "exceeded": ab >= ABSENCE_LIMIT_MIN,
                    "late_min": round(late_min, 1),
                    "match": status,
                    "matched_sheet_name": matched or "",
                })
            meetings.append({
                "uuid": m["uuid"],
                "meeting_id": m["meeting_id"],
                "topic": m["topic"],
                "start": m["start_ts"],
                "end": m["end_ts"],
                "participants": plist,
            })
        alerts = [dict(r) for r in conn.execute(
            "SELECT * FROM alerts ORDER BY ts DESC LIMIT 100").fetchall()]
        elig_total = conn.execute("SELECT COUNT(*) n FROM eligibility").fetchone()["n"]
        elig_ok = conn.execute(
            "SELECT COUNT(*) n FROM eligibility WHERE eligible=1").fetchone()["n"]
        excl = conn.execute("SELECT COUNT(*) n FROM exclusions").fetchone()["n"]
    return {
        "now": now,
        "config": {"absence_limit_min": ABSENCE_LIMIT_MIN,
                   "late_alert_min": LATE_ALERT_MIN,
                   "signature_check": bool(SECRET)},
        "meetings": meetings,
        "alerts": alerts,
        "eligibility": {"total": elig_total, "accepted": elig_ok,
                        "rejected": elig_total - elig_ok},
        "exclusions_count": excl,
    }

# ------------------------------------------------------------------ CSV in

ACCEPT_WORDS = {"accept", "accepted", "yes", "true", "1", "allow", "allowed",
                "مقبول", "نعم", "حاضر"}
REJECT_WORDS = {"reject", "rejected", "no", "false", "0", "deny", "denied",
                "مرفوض", "لا", "غائب"}

def import_eligibility(text, mode):
    if text.startswith("﻿"):
        text = text[1:]
    reader = csv.reader(text.splitlines())
    rows = [r for r in reader if any((c or "").strip() for c in r)]
    if not rows:
        return {"error": "empty file"}
    header = [h.strip().lower() for h in rows[0]]
    def col(*names, default=None):
        for n in names:
            if n in header:
                return header.index(n)
        return default
    ci_name = col("name", "full_name", "trainee", "الاسم", "اسم")
    ci_dec = col("decision", "status", "eligible", "attendance", "القرار", "الحالة")
    ci_alias = col("aliases", "alias", "zoom_name", "zoom name")
    if ci_name is None or ci_dec is None:
        return {"error": "CSV needs columns: name,decision (accept/reject), "
                         "optional aliases"}
    imported = ok = no = 0
    skipped = []
    with LOCK, db() as conn:
        if mode != "append":
            conn.execute("DELETE FROM eligibility")
            conn.execute("DELETE FROM aliases")
        for r in rows[1:]:
            name = (r[ci_name] if ci_name < len(r) else "").strip()
            dec = (r[ci_dec] if ci_dec < len(r) else "").strip().lower()
            if not name:
                continue
            if dec in ACCEPT_WORDS:
                eligible = 1
            elif dec in REJECT_WORDS:
                eligible = 0
            else:
                skipped.append(name)
                continue
            key = normalize(name)
            conn.execute(
                "INSERT INTO eligibility (name_key, display_name, eligible)"
                " VALUES (?,?,?) ON CONFLICT(name_key) DO UPDATE SET"
                " display_name=excluded.display_name,"
                " eligible=excluded.eligible", (key, name, eligible))
            if ci_alias is not None and ci_alias < len(r):
                for alias in (r[ci_alias] or "").split("|"):
                    ak = normalize(alias)
                    if ak:
                        conn.execute(
                            "INSERT OR REPLACE INTO aliases"
                            " (alias_key, name_key) VALUES (?,?)", (ak, key))
            imported += 1
            ok += eligible
            no += 1 - eligible
    return {"imported": imported, "accepted": ok, "rejected": no,
            "skipped": skipped}

