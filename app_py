# ------------------------------------------------------------------- HTTP

class Handler(BaseHTTPRequestHandler):
    server_version = "ZoomAttendanceMonitor/1.0"

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj, ensure_ascii=False))

    def _read_body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(n)

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif path == "/health":
            self._json({"ok": True})
        elif path == "/api/state":
            self._json(build_state())
        elif path == "/api/eligibility":
            with LOCK, db() as conn:
                rows = [dict(r) for r in conn.execute(
                    "SELECT display_name, eligible FROM eligibility"
                    " ORDER BY display_name").fetchall()]
            self._json({"names": rows})
        elif path == "/api/exclusions":
            with LOCK, db() as conn:
                rows = [dict(r) for r in conn.execute(
                    "SELECT display_name, reason, added_ts FROM exclusions"
                    " ORDER BY added_ts DESC").fetchall()]
            self._json({"exclusions": rows})
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        path = urlparse(self.path).path
        body = self._read_body()

        if path == "/zoom/webhook":
            try:
                data = json.loads(body.decode("utf-8", "replace") or "{}")
            except Exception:
                self._json({"error": "bad json"}, 400)
                return
            event = data.get("event", "")
            # Endpoint validation: the CRC challenge-response itself proves
            # we hold the secret token; Zoom does not sign this request.
            if event == "endpoint.url_validation":
                plain = (data.get("payload") or {}).get("plainToken", "")
                enc = hmac.new(SECRET.encode(), plain.encode(),
                               hashlib.sha256).hexdigest()
                self._json({"plainToken": plain, "encryptedToken": enc})
                return
            if SECRET:
                ts_hdr = self.headers.get("x-zm-request-timestamp", "")
                sig = self.headers.get("x-zm-signature", "")
                msg = "v0:" + ts_hdr + ":" + body.decode("utf-8", "replace")
                digest = hmac.new(SECRET.encode(), msg.encode(),
                                  hashlib.sha256).hexdigest()
                if not hmac.compare_digest("v0=" + digest, sig):
                    self._json({"error": "bad signature"}, 401)
                    return
            handle_event(event, data.get("payload"), data.get("event_ts"))
            self._json({"ok": True})
            return

        if path == "/api/eligibility":
            mode = parse_qs(urlparse(self.path).query).get("mode", [""])[0]
            result = import_eligibility(body.decode("utf-8", "replace"), mode)
            self._json(result, 400 if "error" in result else 200)
            return

        if path == "/api/eligibility/clear":
            with LOCK, db() as conn:
                conn.execute("DELETE FROM eligibility")
                conn.execute("DELETE FROM aliases")
            self._json({"ok": True})
            return

        if path == "/api/exclusions":
            try:
                d = json.loads(body.decode("utf-8", "replace") or "{}")
            except Exception:
                d = {}
            name = (d.get("name") or "").strip()
            if not name:
                self._json({"error": "name required"}, 400)
                return
            with LOCK, db() as conn:
                conn.execute(
                    "INSERT OR REPLACE INTO exclusions"
                    " (name_key, display_name, reason, added_ts)"
                    " VALUES (?,?,?,?)",
                    (normalize(name), name, d.get("reason") or "",
                     time.time()))
            self._json({"ok": True})
            return

        if path == "/api/exclusions/remove":
            try:
                d = json.loads(body.decode("utf-8", "replace") or "{}")
            except Exception:
                d = {}
            with LOCK, db() as conn:
                conn.execute("DELETE FROM exclusions WHERE name_key=?",
                             (normalize(d.get("name") or ""),))
            self._json({"ok": True})
            return

        self._json({"error": "not found"}, 404)

def main():
    init_db()
    if not SECRET:
        print("WARNING: ZOOM_SECRET_TOKEN not set - signature checks off "
              "(local testing only)", flush=True)
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    print(f"Listening on :{PORT} - status page at /", flush=True)
    srv.serve_forever()

if __name__ == "__main__":
    main()
